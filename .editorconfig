root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.{xml,fxml,yml,yaml,json}]
indent_size = 2

[pom.xml]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[{mvnw,*.sh}]
end_of_line = lf

[*.{cmd,bat}]
end_of_line = crlf
