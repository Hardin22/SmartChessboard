<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.example.javachess.Components.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<GameLayout fx:id="reviewView" styleClass="page" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.javachess.Controllers.ReviewController">
    <fx:define>
        <fx:include fx:id="stockfishControls" source="StockfishControls.fxml"/>
    </fx:define>

    <header>
        <PageHeader fx:id="header" title="%review.title" subtitle="%review.subtitle" onBack="#backToArchive">
            <actions>
                <Button onAction="#toggleSettings" styleClass="btn, btn-ghost, icon-btn" accessibleText="%game.analysis">
                    <graphic><FontIcon iconLiteral="fth-sliders" iconSize="22" styleClass="icon"/></graphic>
                </Button>
            </actions>
        </PageHeader>
    </header>

    <board>
        <StackPane fx:id="reviewHbox" styleClass="board-holder"/>
    </board>

    <bottomBar>
        <HBox styleClass="toolbar" alignment="CENTER">
            <Button onAction="#firstMove" styleClass="btn, btn-secondary, icon-btn-lg" accessibleText="Inizio">
                <graphic><FontIcon iconLiteral="fth-chevrons-left" iconSize="22" styleClass="icon"/></graphic>
            </Button>
            <Button onAction="#previousMove" styleClass="btn, btn-secondary, icon-btn-lg" accessibleText="Indietro">
                <graphic><FontIcon iconLiteral="fth-chevron-left" iconSize="24" styleClass="icon"/></graphic>
            </Button>
            <Label fx:id="plyLabel" styleClass="mono, muted" alignment="CENTER" maxWidth="Infinity" HBox.hgrow="ALWAYS" text="—"/>
            <Button onAction="#nextMove" styleClass="btn, btn-primary, icon-btn-lg" accessibleText="Avanti">
                <graphic><FontIcon iconLiteral="fth-chevron-right" iconSize="24" styleClass="icon"/></graphic>
            </Button>
            <Button onAction="#lastMove" styleClass="btn, btn-secondary, icon-btn-lg" accessibleText="Fine">
                <graphic><FontIcon iconLiteral="fth-chevrons-right" iconSize="22" styleClass="icon"/></graphic>
            </Button>
        </HBox>
    </bottomBar>

    <side>
        <VBox spacing="12">
            <!-- Summary: analyze button, progress, then accuracy + graph -->
            <VBox fx:id="summaryCard" styleClass="card" spacing="12">
                <HBox fx:id="analyzeRow" alignment="CENTER_LEFT" spacing="16">
                    <VBox spacing="2" HBox.hgrow="ALWAYS" minWidth="0">
                        <Label text="%review.accuracy" styleClass="card-title"/>
                        <Label fx:id="analyzeHint" text="%review.subtitle" styleClass="card-description" wrapText="true"/>
                    </VBox>
                    <Button fx:id="analyzeButton" text="%review.analyze" onAction="#startFullAnalysis" styleClass="btn, btn-primary">
                        <graphic><FontIcon iconLiteral="fth-activity" iconSize="18" styleClass="icon"/></graphic>
                    </Button>
                </HBox>

                <VBox fx:id="progressContainer" spacing="8" visible="false" managed="false">
                    <Label fx:id="percentLabel" styleClass="card-description"/>
                    <ProgressBar fx:id="analysisProgressIndicator" progress="0" maxWidth="Infinity"/>
                </VBox>

                <VBox fx:id="accuracyWrapper" spacing="12" visible="false" managed="false">
                    <HBox fx:id="accuracyContainer" spacing="12">
                        <VBox styleClass="stat-block" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Region styleClass="player-avatar, white" scaleX="0.5" scaleY="0.5"/>
                                <Label text="%review.accuracy.white" styleClass="stat-label"/>
                            </HBox>
                            <Label fx:id="whiteAccuracyLabel" styleClass="stat-value"/>
                        </VBox>
                        <VBox styleClass="stat-block" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Region styleClass="player-avatar, black" scaleX="0.5" scaleY="0.5"/>
                                <Label text="%review.accuracy.black" styleClass="stat-label"/>
                            </HBox>
                            <Label fx:id="blackAccuracyLabel" styleClass="stat-value"/>
                        </VBox>
                    </HBox>
                    <StackPane fx:id="graphContainer" styleClass="graph-box" prefHeight="132" minHeight="96"/>
                    <Button fx:id="toggleBreakdownButton" onAction="#toggleBreakdown" text="%review.breakdown" styleClass="btn, btn-secondary" maxWidth="Infinity">
                        <graphic><FontIcon iconLiteral="fth-list" iconSize="18" styleClass="icon"/></graphic>
                    </Button>
                </VBox>
            </VBox>

            <VBox fx:id="analysisContainer"/>
            <MoveListView fx:id="moveList" VBox.vgrow="ALWAYS" minHeight="88"/>
        </VBox>
    </side>
</GameLayout>
