<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane fx:id="puzzleView" prefHeight="983.0" prefWidth="607.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.javachess.Controllers.PuzzleController" style="-fx-background-color: transparent;">
    
    <!-- Layer 1: Main Game -->
    <VBox alignment="CENTER" spacing="15">
        <padding>
            <Insets top="20" bottom="20" left="15" right="15"/>
        </padding>

        <!-- Top Bar: Back Button & Puzzle Info -->
        <HBox alignment="CENTER_LEFT" spacing="15">
            <Button onAction="#handleBack" styleClass="icon-button" prefHeight="50" prefWidth="50">
                <graphic>
                    <FontIcon iconLiteral="fas-arrow-left" iconSize="28" iconColor="#E0E0E0"/>
                </graphic>
            </Button>
            
            <VBox HBox.hgrow="ALWAYS" alignment="CENTER_RIGHT" styleClass="glass-card" maxWidth="Infinity">
                <Label fx:id="puzzleInfoLabel" styleClass="sub-header-label" text="Puzzle #ID • Rating 1500"/>
                <Label fx:id="statusLabel" styleClass="header-label" text="Trova la mossa!" style="-fx-font-size: 28px; -fx-text-fill: #E0E0E0;"/>
                <Label fx:id="turnLabel" styleClass="sub-header-label" text="Tocca al BIANCO" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #D4AF37;"/>
            </VBox>
        </HBox>

        <!-- Chess Board -->
        <HBox fx:id="puzzleBoardContainer" alignment="CENTER" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 20, 0, 0, 10);">
             <!-- Board added dynamically -->
        </HBox>

        <!-- Bottom Bar: Controls -->
        <HBox alignment="CENTER" spacing="20" maxWidth="Infinity">
             <Button fx:id="hintButton" onAction="#handleHint" styleClass="elegant-button-secondary" text="SUGGERIMENTO" prefHeight="60" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                <graphic>
                    <FontIcon iconLiteral="mdal-lightbulb" iconSize="24" iconColor="#E0E0E0"/>
                </graphic>
             </Button>
             
             <Button onAction="#handleSolution" styleClass="elegant-button-secondary" text="ARRENDITI" prefHeight="60" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                <graphic>
                    <FontIcon iconLiteral="fas-flag" iconSize="24" iconColor="#E0E0E0"/>
                </graphic>
             </Button>
             
             <Button fx:id="nextButton" onAction="#handleNewPuzzle" styleClass="elegant-button" text="PROSSIMO" prefHeight="60" maxWidth="Infinity" HBox.hgrow="ALWAYS" visible="false" managed="false" style="-fx-background-color: #4CAF50;">
                <graphic>
                    <FontIcon iconLiteral="fas-arrow-right" iconSize="24" iconColor="white"/>
                </graphic>
             </Button>
        </HBox>
        
        <!-- Instruction Label (Hidden/Optional) -->
        <Label fx:id="instructionLabel" visible="false"/>
    </VBox>

</StackPane>
