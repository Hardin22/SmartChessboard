<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.example.javachess.Components.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<GameLayout fx:id="puzzleView" styleClass="page" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.javachess.Controllers.PuzzleController">
    <fx:define>
        <!-- PuzzleGame writes its messages here; the status label mirrors it. -->
        <Label fx:id="instructionLabel"/>
    </fx:define>

    <header>
        <PageHeader fx:id="header" title="%puzzle.title" onBack="#handleBack"/>
    </header>

    <topBar>
        <HBox styleClass="player-bar" spacing="14">
            <Region fx:id="turnAvatar" styleClass="player-avatar, white"/>
            <VBox spacing="1" HBox.hgrow="ALWAYS" minWidth="0">
                <Label fx:id="statusLabel" text="%puzzle.find" styleClass="player-name" wrapText="true"/>
                <Label fx:id="turnLabel" text="%puzzle.turn.white" styleClass="player-meta"/>
            </VBox>
            <Label fx:id="ratingBadge" styleClass="badge, mono"/>
        </HBox>
    </topBar>

    <board>
        <StackPane fx:id="puzzleBoardContainer" styleClass="board-holder"/>
    </board>

    <bottomBar>
        <HBox styleClass="toolbar" minHeight="-Infinity">
            <Button fx:id="hintButton" onAction="#handleHint" text="%puzzle.hint" styleClass="btn, btn-secondary, btn-lg" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                <graphic><FontIcon iconLiteral="fth-help-circle" iconSize="20" styleClass="icon"/></graphic>
            </Button>
            <Button fx:id="giveUpButton" onAction="#handleSolution" text="%puzzle.giveup" styleClass="btn, btn-secondary, btn-lg" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                <graphic><FontIcon iconLiteral="fth-flag" iconSize="20" styleClass="icon"/></graphic>
            </Button>
            <Button fx:id="nextButton" onAction="#handleNewPuzzle" text="%puzzle.next" styleClass="btn, btn-primary, btn-lg" maxWidth="Infinity" HBox.hgrow="ALWAYS" visible="false" managed="false">
                <graphic><FontIcon iconLiteral="fth-arrow-right" iconSize="20" styleClass="icon"/></graphic>
            </Button>
        </HBox>
    </bottomBar>

    <side>
        <VBox spacing="12">
            <Label text="%puzzle.themes" styleClass="section-label"/>
            <FlowPane fx:id="themeChips" hgap="8" vgap="8"/>
        </VBox>
    </side>
</GameLayout>
