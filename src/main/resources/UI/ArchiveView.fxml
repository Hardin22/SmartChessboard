<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="archiveView" alignment="TOP_CENTER" spacing="20" style="-fx-background-color: #1a1a1a;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.javachess.Controllers.ArchiveController">
    <padding>
        <Insets top="20" bottom="20" left="20" right="20"/>
    </padding>

    <!-- Top Bar -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <Button onAction="#backToHome" styleClass="neo-button-secondary" prefHeight="50" prefWidth="50">
            <graphic>
                <ImageView fitHeight="30" fitWidth="30" preserveRatio="true">
                    <image>
                        <Image url="@/images/icon_back.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>
        <Label text="ARCHIVIO" styleClass="neo-label-large" maxWidth="Infinity" HBox.hgrow="ALWAYS" alignment="CENTER"/>
        <HBox prefWidth="50" /> <!-- Spacer -->
    </HBox>

    <!-- Archive List -->
    <ListView fx:id="archiveListView" VBox.vgrow="ALWAYS" styleClass="list-view"/>

</VBox>
