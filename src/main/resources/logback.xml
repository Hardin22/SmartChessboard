<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging configuration.
  - Console: INFO and above (DEBUG with -Djavachess.log.level=DEBUG).
  - File: ~/.javachess/logs/javachess.log (or $JAVACHESS_HOME/logs), rotated daily and at 10 MB,
    14 days / 200 MB kept at most. Attach this file to bug reports.
  Never log tokens, passwords or cookies.
-->
<configuration>
    <variable name="LOG_HOME" value="${javachess.home:-${JAVACHESS_HOME:-${user.home}/.javachess}}/logs"/>
    <variable name="LOG_LEVEL" value="${javachess.log.level:-INFO}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/javachess.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/javachess.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Chatty third-party libraries -->
    <logger name="org.apache.http" level="WARN"/>
    <logger name="kong.unirest" level="WARN"/>
    <logger name="ai.onnxruntime" level="WARN"/>

    <root level="${LOG_LEVEL}">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
