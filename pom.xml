<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.hardin22</groupId>
    <artifactId>javaChess</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>javaChess</name>
    <description>Smart chessboard software: play against Stockfish/Maia, online on Lichess and chess.com, puzzles,
        game review and archive, driven by a sensor/LED board connected to an Arduino.</description>
    <url>https://github.com/Hardin22/SmartChessboard</url>
    <inceptionYear>2024</inceptionYear>

    <licenses>
        <license>
            <name>GNU General Public License v3.0 or later</name>
            <url>https://www.gnu.org/licenses/gpl-3.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Francesco Albano</name>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/Hardin22/SmartChessboard</url>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.0</junit.version>
        <skipE2E>false</skipE2E>
        <!-- opt-in: real Chromium (JCEF) on a local page, see BrowserJcefE2E; -DskipJcefE2E=false -->
        <skipJcefE2E>true</skipJcefE2E>
    </properties>

    <repositories>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>

        <repository>
            <id>jogamp</id>
            <url>https://www.jogamp.org/deployment/maven</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>com.github.bhlangonijr</groupId>
            <artifactId>chesslib</artifactId>
            <version>1.3.3</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>21.0.1</version>
        </dependency>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>21.0.1</version>
        </dependency>
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-javafx</artifactId>
            <version>12.3.1</version>
        </dependency>
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-feather-pack</artifactId>
            <version>12.3.1</version>
        </dependency>



        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <!-- 20231013+ is public domain; older releases use the GPL-incompatible "JSON License" -->
            <version>20240303</version>
        </dependency>
        <dependency>
            <groupId>me.friwi</groupId>
            <artifactId>jcefmaven</artifactId>
            <version>146.0.10</version>
        </dependency>
        <dependency>
            <groupId>com.konghq</groupId>
            <artifactId>unirest-java</artifactId>
            <version>3.13.6</version> <!-- Puoi aggiornare alla versione più recente se necessario -->
        </dependency>



        <dependency>
            <groupId>org.kordamp.bootstrapfx</groupId>
            <artifactId>bootstrapfx-core</artifactId>
            <version>0.4.0</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>21.0.1</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-swing</artifactId>
            <version>21.0.1</version>
        </dependency>
        
        <!-- JOGL Removed: Incompatible with macOS ARM64 and not needed for Windowed Mode -->

        <!-- Dipendenza per jSerialComm -->
        <dependency>
            <groupId>com.fazecast</groupId>
            <artifactId>jSerialComm</artifactId>
            <version>2.9.3</version>
        </dependency>


        <!-- Logging: SLF4J API + Logback (configuration in src/main/resources/logback.xml).
             slf4j-api is declared explicitly so that no transitive 1.7.x API wins. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.16</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.5.12</version>
        </dependency>

        <!-- Computer Vision & AI Dependencies -->
        <dependency>
            <groupId>org.openpnp</groupId>
            <artifactId>opencv</artifactId>
            <version>4.9.0-0</version>
        </dependency>
        <dependency>
            <groupId>com.microsoft.onnxruntime</groupId>
            <artifactId>onnxruntime</artifactId>
            <version>1.23.0</version>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- Datasets (puzzles.csv is ~1 GB) never go to the classpath or the jar: see docs/raspberry-pi.md -->
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>data/**</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                </configuration>
            </plugin>

            <plugin>
                <!-- Maven 3.8 defaults to surefire 2.12, which does not run JUnit 5 tests -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <systemPropertyVariables>
                        <java.awt.headless>true</java.awt.headless>
                        <!-- tests never read or write the real ~/.javachess nor the working directory files -->
                        <javachess.home>${project.build.directory}/test-home</javachess.home>
                        <javachess.legacyDir>${project.build.directory}/test-legacy</javachess.legacyDir>
                    </systemPropertyVariables>
                    <!-- end-to-end tests run in their own JVM (execution "e2e" below) -->
                    <excludes>
                        <exclude>**/e2e/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <!-- Real views + game classes + scripted engine; skipped without a display (CI: xvfb-run).
                             Skip locally with -DskipE2E=true -->
                        <id>e2e</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <skip>${skipE2E}</skip>
                            <!-- one JVM per class: each configures the global singletons its own way (board off / sim) -->
                            <reuseForks>false</reuseForks>
                            <excludes combine.self="override"/>
                            <includes>
                                <include>**/e2e/**/*Test.java</include>
                            </includes>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- Integrated browser with real Chromium: needs a display and the JCEF bundle (downloaded on
                             first use). Opt-in: -DskipJcefE2E=false -->
                        <id>jcef-e2e</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <skip>${skipJcefE2E}</skip>
                            <argLine>--add-exports=java.desktop/sun.awt=ALL-UNNAMED --add-opens=java.desktop/sun.awt=ALL-UNNAMED --add-exports=java.desktop/sun.lwawt=ALL-UNNAMED --add-exports=java.desktop/sun.lwawt.macosx=ALL-UNNAMED --add-opens=java.desktop/sun.lwawt=ALL-UNNAMED --add-opens=java.desktop/sun.lwawt.macosx=ALL-UNNAMED</argLine>
                            <systemPropertyVariables combine.children="append">
                                <java.awt.headless>false</java.awt.headless>
                            </systemPropertyVariables>
                            <excludes combine.self="override"/>
                            <includes>
                                <include>**/*JcefE2E.java</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <executions>
                    <execution>
                        <id>default-cli</id>
                        <configuration>
                            <mainClass>io.github.hardin22.javachess.Application.Main</mainClass>
                            <launcher>app</launcher>
                            <jlinkZipName>app</jlinkZipName>
                            <jlinkImageName>app</jlinkImageName>
                            <noManPages>true</noManPages>
                            <stripDebug>true</stripDebug>
                            <noHeaderFiles>true</noHeaderFiles>
                            <options>
                                <option>--add-exports</option>
                                <option>java.desktop/sun.awt=ALL-UNNAMED</option>
                                <option>--add-exports</option>
                                <option>java.desktop/sun.lwawt=ALL-UNNAMED</option>
                                <option>--add-exports</option>
                                <option>java.desktop/sun.lwawt.macosx=ALL-UNNAMED</option>
                                <option>--add-opens</option>
                                <option>java.desktop/sun.awt=ALL-UNNAMED</option>
                                <option>--add-opens</option>
                                <option>java.desktop/sun.lwawt=ALL-UNNAMED</option>
                                <option>--add-opens</option>
                                <option>java.desktop/sun.lwawt.macosx=ALL-UNNAMED</option>
                                <option>--add-exports</option>
                                <option>javafx.web/com.sun.javafx.webkit=ALL-UNNAMED</option>
                            </options>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <!-- signatures of the original jars are invalid in the merged jar -->
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>io.github.hardin22.javachess.Application.Main</mainClass>
                                    <manifestEntries>
                                        <!-- JCEF on macOS (CefBrowserWindowMac) uses java.desktop internals; ignored where absent -->
                                        <Add-Exports>java.desktop/sun.awt java.desktop/sun.lwawt java.desktop/sun.lwawt.macosx</Add-Exports>
                                        <Add-Opens>java.desktop/sun.awt java.desktop/sun.lwawt java.desktop/sun.lwawt.macosx</Add-Opens>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Raspberry Pi (Linux arm64) jar without the native libraries of other platforms (~250 MB less):
             ./mvnw -Ppi -Djavafx.platform=linux-aarch64 -DskipTests package   (see docs/raspberry-pi.md) -->
        <profile>
            <id>pi</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <configuration>
                            <filters combine.children="append">
                                <filter>
                                    <artifact>org.openpnp:opencv</artifact>
                                    <excludes>
                                        <exclude>nu/pattern/opencv/osx/**</exclude>
                                        <exclude>nu/pattern/opencv/windows/**</exclude>
                                        <exclude>nu/pattern/opencv/linux/x86_32/**</exclude>
                                        <exclude>nu/pattern/opencv/linux/x86_64/**</exclude>
                                        <exclude>nu/pattern/opencv/linux/ARMv7/**</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>com.microsoft.onnxruntime:onnxruntime</artifact>
                                    <excludes>
                                        <exclude>ai/onnxruntime/native/osx-*/**</exclude>
                                        <exclude>ai/onnxruntime/native/win-*/**</exclude>
                                        <exclude>ai/onnxruntime/native/linux-x64/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
